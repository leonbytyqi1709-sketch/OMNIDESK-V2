{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/cron/uptime-refresh",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/neon-refresh",
      "schedule": "5 6 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ]
}
