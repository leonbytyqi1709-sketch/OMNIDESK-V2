{
  "name": "omnidesk",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build && npm run bundle:api",
    "lint": "oxlint",
    "preview": "vite preview",
    "bundle:api": "esbuild server/vercel-entry.ts --bundle --platform=node --format=esm --packages=external --outfile=api/[[...route]].js",
    "db:generate": "drizzle-kit generate",
