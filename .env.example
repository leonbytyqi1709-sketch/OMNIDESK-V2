# OmniDesk – Umgebungsvariablen
# Lokal: Kopiere diese Datei zu .env.local und fülle die Werte ein.
# Vercel: Trage alle Variablen unter Project → Settings → Environment Variables ein.

# --- Datenbank (Neon Postgres) ---
DATABASE_URL=

# --- Auth (Clerk) ---
# Publishable Key; wird Frontend UND API-Server benutzt (JWKS-Verifizierung)
VITE_CLERK_PUBLISHABLE_KEY=

# --- KI-Assistent (Groq oder OpenAI-kompatibel) ---
OPENAI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# --- Google-Integration (Drive) ---
# Muss in der Produktion auf die Live-Domain zeigen und in der
# Google Cloud Console als autorisierte Redirect-URI eingetragen sein.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Scheduler-Authentifizierung (Vercel Hobby: täglich; extern engmaschiger) ---
# Beliebiger langer Zufallswert; Vercel sendet ihn als Bearer-Token.
CRON_SECRET=

# --- Zeitzone (Booking-Termine, Serverless läuft sonst in UTC) ---
TZ=Europe/Berlin


# --- Microsoft OneDrive (privat sowie Geschäfts-/Schulkonten) ---
# Einrichtung: docs/ONEDRIVE-SETUP.md; nur serverseitige Variablen!
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://omnidesk-v2-beta.vercel.app/api/integrations/microsoft/callback
MICROSOFT_TENANT=common

# --- Neon-Monitoring (lesende Verwaltungs-API, NICHT DATABASE_URL) ---
# Einrichtung und sichere Projektzuordnung: docs/NEON-MONITORING.md
NEON_API_KEY=
NEON_MONITOR_LINKS=[]

# --- Deployment-Zentrale (nur lesende Vercel-Verwaltungs-API) ---
# Einrichtung: docs/VERCEL-MONITORING.md; Token nie mit VITE_-Präfix!
DEPLOYMENT_API_TOKEN=
DEPLOYMENT_PROJECT_LINKS=[]

# Clerk user allowed to browse all Vercel projects accessible by DEPLOYMENT_API_TOKEN
DEPLOYMENT_ACCOUNT_USER_ID=

# --- Neon full monitoring (docs/NEON-MONITORING.md) ---
# Actual external scheduler must be configured separately; Hobby fallback is daily.
NEON_SCHEDULER_INTERVAL_MINUTES=1440
# Optional SQL probe targets: [{"neonProjectId":"...","branchId":"...","env":"NEON_SQL_OMNIDESK_URL"}]
# Connection secret must match the branch endpoint and use sslmode=require/verify-full.
NEON_SQL_TARGETS=[]
NEON_SQL_OMNIDESK_URL=

# --- GitHub center (read-only; docs/GITHUB-ZENTRALE.md) ---
GITHUB_API_TOKEN=
GITHUB_ACCOUNT_USER_ID=
